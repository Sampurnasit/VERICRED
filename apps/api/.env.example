# =============================================================================
# VERICRED Backend API Configuration (.env.example)
# =============================================================================

PORT=4000
NODE_ENV=production

# Database connection URL (PostgreSQL 16)
DATABASE_URL="postgresql://vericred:vericred_secure_pass_prod@localhost:5432/vericred_db?schema=public"

# Redis sliding-window cache URL
REDIS_URL="redis://localhost:6379"

# JWT configuration
JWT_SECRET="replace_with_a_secure_random_64_byte_string_for_production_use"
JWT_EXPIRATION="7d"

# Encryption Master Key for Institutional Signing Keys at rest (AES-256-GCM / PBKDF2)
ENCRYPTION_MASTER_KEY="replace_with_a_high_entropy_32_byte_hex_or_passphrase_for_production"

# Allowed web origin
CORS_ORIGIN="http://localhost:3000"

# Blockchain RPC and Smart Contracts (Polygon Amoy Testnet - ChainID 80002)
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
INSTITUTION_REGISTRY_ADDRESS="0xF250601Ca003f6F97ae6a5b24eFFD99FC2D95266"
CREDENTIAL_REGISTRY_ADDRESS="0x35E7F512031B4F46c02e76bb1445E2DC38C7AB22"
REVOCATION_REGISTRY_ADDRESS="0xaacEAe5171E339763C3Cb68C5d2841816058DF78"
GROTH16_VERIFIER_ADDRESS="0x773d420E89a19c6fDeD40f34eA20e104d493A39c"

# Sovereign Blockchain Relayer (Authorized on-chain issuer in InstitutionRegistry)
RELAYER_PRIVATE_KEY=""
USE_CHAIN_VERIFICATION="true"
