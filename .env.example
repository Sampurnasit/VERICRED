# =============================================================================
# VERICRED Root Environment Configuration Template (.env.example)
# =============================================================================
# Duplicate this file to .env before starting the platform.
# Never commit active private keys or database passwords to version control.

# --- Monorepo Runtime Environment ---
NODE_ENV=development
PORT=4000

# --- Database & Persistence ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=vericred_dev
POSTGRES_PORT=5434
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5434/vericred_dev?schema=public"

# --- Redis In-Memory Cache & Rate Limiting ---
REDIS_PORT=6381
REDIS_URL="redis://localhost:6381"

# --- Authentication & Session Security ---
JWT_SECRET="vericred_super_secure_jwt_secret_dev_key_at_least_32_chars_2026"
JWT_EXPIRATION="7d"

# --- Cryptographic Key Protection at Rest (AES-256-GCM Master Key) ---
ENCRYPTION_MASTER_KEY="vericred_master_encryption_secret_dev_32_chars_min!!"

# --- CORS & Domain Boundary ---
CORS_ORIGIN="http://localhost:3000"

# --- Blockchain Network (Polygon Amoy Testnet) ---
POLYGON_AMOY_RPC_URL="https://polygon-amoy-bor-rpc.publicnode.com"
RELAYER_PRIVATE_KEY="YOUR_POLYGON_AMOY_PRIVATE_KEY_HEX_WITHOUT_0X"
POLYGONSCAN_API_KEY="YOUR_POLYGONSCAN_API_KEY_HERE"

# --- Deployed Smart Contract Addresses (Polygon Amoy Testnet) ---
INSTITUTION_REGISTRY_ADDRESS="0xF250601Ca003f6F97ae6a5b24eFFD99FC2D95266"
CREDENTIAL_REGISTRY_ADDRESS="0x35E7F512031B4F46c02e76bb1445E2DC38C7AB22"
REVOCATION_REGISTRY_ADDRESS="0xaacEAe5171E339763C3Cb68C5d2841816058DF78"

# --- Frontend Injections ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_CHAIN_ID="80002"
NEXT_PUBLIC_CHAIN_NAME="Polygon Amoy Testnet"
NEXT_PUBLIC_RPC_URL="https://polygon-amoy-bor-rpc.publicnode.com"
NEXT_PUBLIC_INSTITUTION_REGISTRY_ADDRESS="0xF250601Ca003f6F97ae6a5b24eFFD99FC2D95266"
NEXT_PUBLIC_CREDENTIAL_REGISTRY_ADDRESS="0x35E7F512031B4F46c02e76bb1445E2DC38C7AB22"
NEXT_PUBLIC_REVOCATION_REGISTRY_ADDRESS="0xaacEAe5171E339763C3Cb68C5d2841816058DF78"
