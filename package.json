{
  "name": "vericred",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "turbo run build",
    "dev": "pnpm build:packages && turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "prettier": "^3.5.3"
  },
  "packageManager": "pnpm@11.5.1"
}
