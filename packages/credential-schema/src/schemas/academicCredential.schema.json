{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VeriCredAcademicCredential",
  "type": "object",
  "required": [
    "@context",
    "id",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject",
    "credentialStatus",
    "proof"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "items": { "type": "string" }
    },
    "id": { "type": "string", "format": "uri" },
    "type": {
      "type": "array",
      "items": { "type": "string" }
    },
    "issuer": {
      "type": "object",
      "required": ["id", "name", "ethereumAddress"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "legalEntityCode": { "type": "string" },
        "ethereumAddress": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "publicKeyX": { "type": "string" },
        "publicKeyY": { "type": "string" }
      }
    },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "type": "object",
      "required": [
        "id",
        "studentName",
        "enrollmentNumber",
        "degreeName",
        "department",
        "graduationYear",
        "academicStanding"
      ],
      "properties": {
        "id": { "type": "string" },
        "studentName": { "type": "string" },
        "enrollmentNumber": { "type": "string" },
        "degreeName": { "type": "string" },
        "department": { "type": "string" },
        "academicSession": { "type": "string" },
        "graduationYear": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "classification": { "type": "string" },
        "academicStanding": {
          "type": "object",
          "required": ["cgpaRaw", "cgpaScaled", "blindingSalt", "commitment"],
          "properties": {
            "cgpaRaw": { "type": "number", "minimum": 0.0, "maximum": 10.0 },
            "cgpaScaled": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "blindingSalt": { "type": "string", "pattern": "^[0-9]+$" },
            "commitment": { "type": "string", "pattern": "^[0-9]+$" }
          }
        }
      }
    },
    "credentialStatus": {
      "type": "object",
      "required": ["id", "type", "contractAddress", "credentialHash"],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "type": "string" },
        "network": { "type": "string" },
        "contractAddress": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "credentialHash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" }
      }
    },
    "proof": {
      "type": "object",
      "required": ["type", "created", "verificationMethod", "proofPurpose", "signatureValue"],
      "properties": {
        "type": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "verificationMethod": { "type": "string" },
        "proofPurpose": { "type": "string" },
        "signatureValue": {
          "type": "object",
          "required": ["r8x", "r8y", "s"],
          "properties": {
            "r8x": { "type": "string" },
            "r8y": { "type": "string" },
            "s": { "type": "string" }
          }
        }
      }
    }
  }
}
